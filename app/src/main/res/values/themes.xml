<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches the Compose dark background to avoid a white flash at startup. -->
    <style name="Theme.PlakaGozcusu" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.PlakaGozcusu.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PlakaGozcusu</item>
    </style>
</resources>
